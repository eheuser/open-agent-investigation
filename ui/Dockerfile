FROM node:26-alpine AS builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps
COPY . .

RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine

# Copy nginx config and built assets with proper ownership
COPY --from=builder --chown=nginx:nginx /app/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder --chown=nginx:nginx /app/dist /usr/share/nginx/html

# Create SSL directory with proper ownership (nginx user is UID 101)
USER root
RUN mkdir -p /etc/nginx/ssl && \
    chown -R nginx:nginx /etc/nginx/ssl
USER nginx

# Create entrypoint script for certificate handling (non-root version)
USER root
RUN echo '#!/bin/sh' > /docker-entrypoint.sh && \
    echo 'set -e' >> /docker-entrypoint.sh && \
    echo '' >> /docker-entrypoint.sh && \
    echo '# Check if certificates exist in mounted volume' >> /docker-entrypoint.sh && \
    echo 'if [ ! -f /certs/server.key ] || [ ! -f /certs/server.crt ]; then' >> /docker-entrypoint.sh && \
    echo '  echo "ERROR: SSL certificates not found in /certs"' >> /docker-entrypoint.sh && \
    echo '  echo "Certificates must be generated by cert-generator init container"' >> /docker-entrypoint.sh && \
    echo '  exit 1' >> /docker-entrypoint.sh && \
    echo 'fi' >> /docker-entrypoint.sh && \
    echo '' >> /docker-entrypoint.sh && \
    echo 'echo "Using SSL certificates from /certs"' >> /docker-entrypoint.sh && \
    echo '' >> /docker-entrypoint.sh && \
    echo '# Copy certificates to nginx ssl directory' >> /docker-entrypoint.sh && \
    echo 'cp /certs/server.crt /etc/nginx/ssl/server.crt' >> /docker-entrypoint.sh && \
    echo 'cp /certs/server.key /etc/nginx/ssl/server.key' >> /docker-entrypoint.sh && \
    echo '' >> /docker-entrypoint.sh && \
    echo '# Start nginx as non-root user' >> /docker-entrypoint.sh && \
    echo 'exec nginx -g "daemon off;"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh && \
    chown nginx:nginx /docker-entrypoint.sh

USER nginx

# Expose unprivileged port (8443 instead of 443)
EXPOSE 8443
CMD ["/docker-entrypoint.sh"]
