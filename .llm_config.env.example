# ============================================================================
# LLM Configuration Environment Variables
# ============================================================================
# Copy this file to .llm_config.env and configure your LLM provider settings.
# On container startup, these settings will be automatically applied to the
# admin user's LLM configuration, bypassing the need for UI configuration.
#
# IMPORTANT: Keep .llm_config.env secret - it contains API keys!
# ============================================================================

# ============================================================================
# BASIC LLM CONFIGURATION (Required)
# ============================================================================

# LLM Provider name (e.g., openai, ollama, azure, anthropic, custom)
LLM_PROVIDER_NAME=openai

# LLM API endpoint (full URL including path)
# Examples:
#   OpenAI: https://api.openai.com/v1/chat/completions
#   Ollama: http://localhost:11434/v1/chat/completions
#   Azure: https://<resource>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-02-15-preview
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions

# LLM API key (leave empty if not required, e.g., for local Ollama)
LLM_API_KEY=sk-your-api-key-here

# Model name to use
# Examples: gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022, llama3.1:70b
LLM_MODEL_NAME=gpt-4o-mini

# Maximum context length (tokens) - adjust based on your model
# Examples: 8192, 32768, 128000, 200000
LLM_MAX_CONTEXT_LENGTH=128000

# Temperature (0.0-2.0) - controls randomness
# Lower = more deterministic, Higher = more creative
# Recommended: 0.7 for investigations
LLM_TEMPERATURE=0.70

# ============================================================================
# ADVANCED LLM PARAMETERS (Optional)
# ============================================================================

# Top-p nucleus sampling (0.0-1.0) - uncomment to enable
# LLM_TOP_P=0.95

# Top-k sampling (integer) - uncomment to enable
# LLM_TOP_K=50

# Min-p sampling (0.0-1.0) - uncomment to enable
# LLM_MIN_P=0.05

# Request timeout in seconds (default: 300)
LLM_TIMEOUT=300

# Enable concurrent LLM calls (true/false) - allows parallel requests
# WARNING: May increase costs and rate limit issues
LLM_ALLOW_CONCURRENT=false

# ============================================================================
# EMBEDDING CONFIGURATION (Optional - Required for RAG)
# ============================================================================

# Embedding provider (openai, cohere, ollama, custom)
# Leave empty to disable RAG/semantic search
EMBEDDING_PROVIDER=openai

# Embedding API URL
# Examples:
#   OpenAI: https://api.openai.com/v1/embeddings
#   Cohere: https://api.cohere.ai/v1/embed
#   Ollama: http://localhost:11434/api/embeddings
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings

# Embedding API key (can be same as LLM_API_KEY for OpenAI)
EMBEDDING_API_KEY=sk-your-api-key-here

# Embedding model for initial embedding generation
# Examples:
#   OpenAI: text-embedding-3-small, text-embedding-3-large
#   Cohere: embed-english-v3.0, embed-multilingual-v3.0
#   Ollama: nomic-embed-text, mxbai-embed-large
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Max context length for embedding model (default: 8192)
EMBEDDING_MAX_CONTEXT_LENGTH=8192

# Reranker model for reranking top candidates (more expensive/capable)
# Leave empty to skip reranking step
# Examples: text-embedding-3-large (OpenAI), rerank-english-v3.0 (Cohere)
RERANKER_MODEL_NAME=text-embedding-3-large

# Max context length for reranker model (default: 8192)
RERANKER_MAX_CONTEXT_LENGTH=8192

# Enable concurrent embedding calls (true/false)
# WARNING: May increase costs and rate limit issues
EMBEDDING_ALLOW_CONCURRENT=false

# ============================================================================
# CONFIGURATION NOTES
# ============================================================================
#
# 1. API Keys:
#    - Store securely and never commit to version control
#    - For OpenAI, you can use the same key for LLM and embeddings
#    - For Ollama (local), leave API keys empty
#
# 2. Context Lengths:
#    - Must match your model's actual capabilities
#    - Larger contexts = more tokens = higher costs
#    - Common values: 8192, 32768, 128000, 200000
#
# 3. Embedding Models:
#    - Small models (text-embedding-3-small): Faster, cheaper, good for most use cases
#    - Large models (text-embedding-3-large): Better accuracy, higher cost
#    - Reranker: Optional second pass for improved relevance
#
# 4. Concurrent Calls:
#    - Disabled by default to avoid rate limits
#    - Enable only if you have high rate limits and need speed
#
# 5. Provider-Specific Notes:
#    - OpenAI: Requires API key, supports all features
#    - Ollama: Local, no API key, limited to available models
#    - Azure: Requires resource name and deployment name in URL
#    - Anthropic: Similar to OpenAI but different endpoint/models
#
# ============================================================================
